root = true

[*.cs]
charset = utf-8
end_of_line = crlf
indent_style = space
indent_size = 4
insert_final_newline = true
trim_trailing_whitespace = true

# Остальные текстовые файлы — LF (по желанию)
[*.{md,json,xml,yml,yaml}]
end_of_line = lf

# Файлы Unity — не трогать
[*.{unity,prefab,asset,meta}]
end_of_line = unset